# Copier en .env (cp .env.example .env) puis modifier le mot de passe.

# Mot de passe de la base PostgreSQL (interne aux conteneurs, jamais exposée).
# Choisir une longue chaîne aléatoire, par exemple : openssl rand -hex 24
POSTGRES_PASSWORD=a-changer

# Port de la machine sur lequel la vitrine répond (HTTP). C'est ce port que le
# reverse proxy HTTPS existant doit cibler : http://127.0.0.1:8080
PORT_HTTP=8080

# Fuseau horaire (horaires des imports FFF, dates affichées)
TZ=Europe/Paris
