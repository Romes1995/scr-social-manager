PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scr_social_manager
DB_USER=postgres
DB_PASSWORD=yourpassword

# Uploads
UPLOADS_DIR=./uploads

# FFF
FFF_URL=https://epreuves.fff.fr/competition/club/504189-s-c-roeschwoog/information.html

# Meta (pour la v1 - non connecté en beta)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Tâches planifiées FFF (services/scheduler.js) : import des matchs + classements,
# heures Europe/Paris. true par défaut ; false/0/no désactive planning et rattrapage
# (les routes manuelles restent actives). Un seul backend par base doit l'avoir à true.
CRON_ENABLED=true

# Sécurité de l'API
# Secret de signature des sessions (JWT), 32 caractères minimum, propre à chaque machine.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origines autorisées à appeler l'API avec le cookie de session (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Interface d'écoute : 0.0.0.0 en dev, 127.0.0.1 en production derrière Nginx
HOST=0.0.0.0
# production : cookie de session Secure (HTTPS obligatoire)
NODE_ENV=development
