# Copier en .env.production avant `npm run build` (Vite l'intègre au build).
# URL publique de l'API backend, avec /api. Les images /uploads en dérivent
# (même hôte, sans /api).
# Vide ou absente : la vitrine appelle /api sur sa propre origine (reverse proxy).
VITE_API_URL=https://api.example.org/api

# vitrine : build de la vitrine seule (deploy/) ; sans /live ni /buteurs.
# Vide : build complet.
VITE_MODE=
